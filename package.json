{
  "name": "alejandro-agredo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare:experiments": "tsx scripts/prepare-experiments.ts",
    "predev": "npm run prepare:experiments",
    "dev": "node scripts/next.mjs dev --webpack --hostname 127.0.0.1 --port 3142",
    "prebuild": "npm run prepare:experiments",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 3142",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/nodemailer": "6.4.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "smtp-server": "3.21.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
