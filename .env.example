# Server-only. Reuse the existing Vercel Gmail OAuth values; never prefix with NEXT_PUBLIC_.
SMTP_TRANSPORT_USER=agredoalejo@gmail.com
GOOGLE_APIS_CLIENT_ID=
GOOGLE_APIS_CLIENT_SECRET=
GOOGLE_APIS_REFRESH_TOKEN=
# Optional: existing Gmail app password instead of OAuth, not your normal password.
SMTP_PASSWORD=
# Optional existing SMTP server. No new email service is required.
CONTACT_MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Additional exact origins, comma-separated. Vercel's deployment URL is recognized automatically.
CONTACT_ALLOWED_ORIGIN=
