# Server-only. Never prefix mail settings or credentials with NEXT_PUBLIC_.
SMTP_TRANSPORT_USER=your-sending-account@gmail.com
# The sending account must be authorized to send as this alias.
CONTACT_SENDER=info@alejandroagredo.com
CONTACT_RECIPIENT=info@alejandroagredo.com
GOOGLE_APIS_CLIENT_ID=
GOOGLE_APIS_CLIENT_SECRET=
GOOGLE_APIS_REFRESH_TOKEN=
# Optional: existing Gmail app password instead of OAuth, not your normal password.
SMTP_PASSWORD=
# Explicit Gmail SMTP uses the work account's app password, not its normal password.
# This mode ignores the legacy OAuth values above.
CONTACT_MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-account@gmail.com
# Additional exact origins, comma-separated. Vercel's deployment URL is recognized automatically.
CONTACT_ALLOWED_ORIGIN=
